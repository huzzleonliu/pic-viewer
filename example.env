# Pic Viewer — 给 podman compose / docker compose 读的环境文件
#
# 用法：
#   1. 复制本文件为项目根目录的 .env（不要用 git 提交 .env）
#        cp example.env .env
#      也可以复制后再把副本改名为 .env。
#   2. 改下面的 PIC_DIR（以及生产镜像 PIC_VIEWER_IMAGE）。
#   3. 直接启动，不必再写 PIC_DIR=... podman compose up：
#        podman compose up -d
#        podman compose -f dev.docker-compose.yml up --build
#
# Compose 只把本文件里的键用来替换 yaml 中的 ${变量}。
# 不会把宿主机路径当成容器内的 PIC_ROOT。容器里相册永远是 /data，
# 改相册请改 PIC_DIR。
#
# 已在跑的栈改完 .env 后需要再 up 一次才会吃到新值：
#   podman compose up -d

# ----- 相册（生产、开发两份 compose 都读）-----
# 宿主机目录，挂到容器 /data（应用读写，imgproxy 只读）。
# 相对路径相对「执行 compose 时的当前目录」，一般是仓库根。
PIC_DIR=./test/pic

# ----- 生产 compose（docker-compose.yml）-----
# 应用镜像。自己 build 后可改成 localhost/pic-viewer:local
#   podman build -t localhost/pic-viewer:local .
PIC_VIEWER_IMAGE=ghcr.io/huzzleonliu/pic-viewer:latest

# 浏览器访问端口（主机）→ 生产容器内 3000，开发容器内 3020
PIC_HOST_PORT=3020

# ----- 开发 compose（dev.docker-compose.yml）-----
# cargo leptos watch 热更新端口，须与容器内 LEPTOS_RELOAD_PORT 一致
LEPTOS_RELOAD_PORT=3021

# 仅开发栈把 imgproxy 映射到主机，方便本机 cargo leptos watch
IMGPROXY_HOST_PORT=8080

# ----- 本机 cargo leptos watch（不用应用容器时）-----
# Compose 不会把下面两项灌进 pic-viewer 容器。
# 若只起 imgproxy、在宿主机跑 watch，取消注释，并与 PIC_DIR / IMGPROXY_HOST_PORT 对齐，然后：
#   podman compose -f dev.docker-compose.yml up imgproxy
#   set -a && source .env && set +a
#   cargo leptos watch
# PIC_ROOT=./test/pic
# IMGPROXY_URL=http://127.0.0.1:8080
